# Tipo correcto para el manifiesto de la app
AddType application/manifest+json .webmanifest

# Sin listado de carpetas
Options -Indexes

# Archivos internos: nunca se sirven por URL
<FilesMatch "^(config\.php|config\.example\.php|conexion\.php|lib\.php|auth\.php|citas_lib\.php|crear_admin\.php\.bak)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sql|md|log|bak|env)$">
    Require all denied
</FilesMatch>

# Encabezados de seguridad básicos
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>
